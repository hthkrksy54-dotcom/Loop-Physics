        "show": {
          "type": "number",
          "big": "$72,000",
          "caption": "Sam: $200 a month, age 35 to 65",
          "color": "blue"
        }
      },
      {
        "say": "At sixty-five, Sam has about two hundred and forty-three thousand dollars. Alex has about two hundred and seventy thousand. Alex wins.",
        "show": {
          "type": "line",
          "heading": "Alex vs Sam at 7% a year",
          "unit": "$",
          "sub": "$200 a month · example, not a forecast",
          "series": [
            {
              "label": "Sam",
              "points": [
